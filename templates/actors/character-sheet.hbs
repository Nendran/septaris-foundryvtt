<section class="flexcol" autocomplete="off">

  {{! Sheet Header }}
  <header class="sheet-header">
    <img
      class="profile-img"
      src="{{actor.thumbnail}}"
      data-edit="img"
      title="{{actor.name}}"
      height="100"
      width="100"
    />
    <div class="sheet-header-info">
      <div>
        <div>Nom : {{actor.name}}</div>
        <div>Origine: {{system.origin}}</div>
      </div>
      <div>
        <div>Niveau: {{system.level}}</div>
        <div>PE: {{system.pe}}</div>
      </div>
    </div>
  </header>

  <section class="sheet-stats">
    <div class="septaris-health">
      <span>♥ PV</span>

      <button type="button" data-health-delta="-1">−</button>

      <input
        type="number"
        name="system.health.value"
        value="{{system.health.value}}"
        min="0"
        max="{{system.health.max}}"
        step="1"
      />

      <button type="button" data-health-delta="1">+</button>

      <span>/ {{system.health.max}}</span>
    </div>

    <div class="septaris-defense">
      <span>🛡 Défense : {{system.defense}}</span>

      <label>
        Équipement
        <input
          type="number"
          name="system.defenseBonus"
          value="{{system.defenseBonus}}"
          min="0"
          step="1"
        />
      </label>
    </div>
    <span title="Prouesse">🎲: D{{system.featDice}}</span>
    <span title="Vitesse">🏃: {{system.speed}}</span>
    <button title="Jet" id="roll">🎲 Jet</button>
  </section>

  <hr />

  <section class="sheet-characteristics">
    {{#each system.characteristicsModifiers as |modifier skill|}}
    <div>
      <span>{{localize (concat "SEPTARIS.Characteristics." (toUpperCase skill))}}: <input type="text" name="{{ concat "system.characteristics." skill}}" value="{{ lookup ../system.characteristics skill}}" data-dtype="Number" /></span>
      <span>{{numberFormat modifier sign=true}}</span>
    </div>
    {{/each}}
  </section>

  {{! Sheet Tab Navigation }}
  <nav class="sheet-tabs tabs" role="tablist" data-group="primary">
    {{#each tabs as |tab|}}
    <a class="dg-tab {{tab.cssClass}}" role="tab"
      id="{{../tabFieldId}}-tab-{{tab.id}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}"
      aria-controls="{{../tabFieldId}}-panel-{{tab.id}}" aria-selected="{{tab.active}}"
      tabindex="{{#if tab.active}}0{{else}}-1{{/if}}">{{tab.label}}</a>
  {{/each}}
  </nav>

  {{! Sheet Body }}
  <section class="sheet-body">

    {{! Biography Tab }}
    <div class="tab biography {{tabs.resume.cssClass}}" data-group="primary" data-tab="resume" role="tabpanel">
      <div class="skills">
        <h2>{{localize "SEPTARIS.Sheet.Skills"}}</h2>
        <div class="skills-list">
          {{#each system.skills as |proficiency name|}}
            <div class="skill" data-action="update-skill" data-skill="{{name}}">
              <span title={{proficiencyName proficiency }}>
                {{skillProficiency proficiency}} {{skillName name}}
              </span>
            </div>
          {{/each}}
        </div>
      </div>
    </div>

    {{! Owned Items Tab }}
    <div class="tab items {{tabs.actions.cssClass}}" data-group="primary" data-tab="actions" role="tabpanel">
      actions items here
    </div>

    {{! Owned Items Tab }}
    <div class="tab items {{tabs.abilities.cssClass}}" data-group="primary" data-tab="abilities" role="tabpanel">
      abilities items here
    </div>

    {{! Owned Items Tab }}
    <div class="tab items {{tabs.inventory.cssClass}}" data-group="primary" data-tab="inventory" role="tabpanel">
      inventory items here
    </div>
    {{! Owned Items Tab }}
    <div class="tab items {{tabs.notes.cssClass}}" data-group="primary" data-tab="notes" role="tabpanel">
      notes items here
    </div>
  </section>
</section>