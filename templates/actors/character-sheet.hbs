<section class="flexcol" autocomplete="off">

  {{! Sheet Header }}
  <header class="sheet-header">
    <img
      class="profile-img"
      src="{{actor.thumbnail}}"
      data-edit="img"
      title="{{actor.name}}"
      height="100"
      width="100"
    />
    <div>
      <div>Nom : {{actor.name}}</div>
      <div>Origine: {{system.origin}}</div>
    </div>
    <div>
      <div>Niveau: {{system.level}}</div>
      <div>PE: {{system.pe}}</div>
    </div>
  </header>

  <section class="sheet-stats">
    <span title="Points de Vie">♥: {{system.health.value}}/{{system.health.max}}</span>
    <span title="Défense">🛡: {{system.defense}}</span>
    <span title="Prouesse">🎲: 1D{{system.featDice}}</span>
    <span title="Vitesse">🏃: {{system.speed}}</span>
  </section>

  <hr />

  <section class="sheet-skills">
    <div>
      <span>Force: <input type="text" name="system.skills.strength" value="{{system.skills.strength}}" data-dtype="Number" /></span>
      <span>{{numberFormat system.skillsModifiers.strength sign=true}}</span>
    </div>
    <div>
      <span>Dextérité: <input type="text" name="system.skills.dexterity" value="{{system.skills.dexterity}}" data-dtype="Number" /></span>
      <span>{{numberFormat system.skillsModifiers.dexterity sign=true}}</span>
    </div>
    <div>
      <span>Constitution: <input type="text" name="system.skills.constitution" value="{{system.skills.constitution}}" data-dtype="Number" /></span>
      <span>{{numberFormat system.skillsModifiers.constitution sign=true}}</span>
    </div>
    <div>
      <span>Intelligence: <input type="text" name="system.skills.intelligence" value="{{system.skills.intelligence}}" data-dtype="Number" /></span>
      <span>{{numberFormat system.skillsModifiers.intelligence sign=true}}</span>
    </div>
    <div>
      <span>Instinct: <input type="text" name="system.skills.instinct" value="{{system.skills.instinct}}" data-dtype="Number" /></span>
      <span>{{numberFormat system.skillsModifiers.instinct sign=true}}</span>
    </div>
    <div>
      <span>Charisme: <input type="text" name="system.skills.charisma" value="{{system.skills.charisma}}" data-dtype="Number" /></span>
      <span>{{numberFormat system.skillsModifiers.charisma sign=true}}</span>
    </div>
  </section>

  {{! Sheet Tab Navigation }}
  <nav class="sheet-tabs tabs" role="tablist" data-group="primary">
    {{#each tabs as |tab|}}
    <a class="dg-tab {{tab.cssClass}}" role="tab"
      id="{{../tabFieldId}}-tab-{{tab.id}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}"
      aria-controls="{{../tabFieldId}}-panel-{{tab.id}}" aria-selected="{{tab.active}}"
      tabindex="{{#if tab.active}}0{{else}}-1{{/if}}">{{tab.label}}</a>
  {{/each}}
  </nav>

  {{! Sheet Body }}
  <section class="sheet-body">

    {{! Biography Tab }}
    <div class="tab biography {{tabs.resume.cssClass}}" data-group="primary" data-tab="resume" role="tabpanel">
      <div class="capacities">
        <h2>{{septarisLocalize "SEPTARIS.Sheet.Capacities"}}</h2>
        <div class="capacities-list">
          {{#each system.capacities as |proficiency name|}}
            <div class="capacity" data-action="update-capacity" data-capacity="{{name}}">
              <span title={{proficiencyName proficiency }}>
                {{capacityProficiency proficiency}} {{capacityName name}}
              </span>
            </div>
          {{/each}}
      </div>
    </div>

    {{! Owned Items Tab }}
    <div class="tab items {{tabs.actions.cssClass}}" data-group="primary" data-tab="actions" role="tabpanel">
      actions items here
    </div>

    {{! Owned Items Tab }}
    <div class="tab items {{tabs.abilities.cssClass}}" data-group="primary" data-tab="abilities" role="tabpanel">
      abilities items here
    </div>

    {{! Owned Items Tab }}
    <div class="tab items {{tabs.inventory.cssClass}}" data-group="primary" data-tab="inventory" role="tabpanel">
      inventory items here
    </div>
    {{! Owned Items Tab }}
    <div class="tab items {{tabs.notes.cssClass}}" data-group="primary" data-tab="notes" role="tabpanel">
      notes items here
    </div>
  </section>
</section>