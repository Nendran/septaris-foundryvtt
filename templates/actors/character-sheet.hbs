<section class="flexcol" autocomplete="off">

  {{! Sheet Header }}
  <header class="sheet-header">
    <img
      class="profile-img"
      src="{{actor.thumbnail}}"
      data-edit="img"
      title="{{actor.name}}"
      height="100"
      width="100"
    />
    <div>
      <div>Nom : {{actor.name}}</div>
      <div>Origine: {{system.origin}}</div>
    </div>
    <div>
      <div>Niveau: {{system.level}}</div>
      <div>PE: {{system.pe}}</div>
    </div>
  </header>

  <section class="sheet-stats">
    <span title="Points de Vie">♥: {{system.health.value}}/{{system.health.max}}</span>
    <span title="Défense">🛡: {{system.defense}}</span>
    <span title="Prouesse">🎲: 1D{{system.featDice}}</span>
    <span title="Vitesse">🏃: {{system.speed}}</span>
  </section>

  <hr />

  <section class="sheet-skills">
    <div class="sheet-skills-skill">
      <span>Force: {{system.skills.strength}}</span>
      <span>{{system.skillsModifiers.strength}}</span>
    </div>
    <div class="sheet-skills-skill">
      <span>Dextérité: {{system.skills.dexterity}}</span>
      <span>{{system.skillsModifiers.dexterity}}</span>
    </div>
    <div class="sheet-skills-skill">
      <span>Constitution: {{system.skills.constitution}}</span>
      <span>{{system.skillsModifiers.constitution}}</span>
    </div>
    <div class="sheet-skills-skill">
      <span>Intelligence: {{system.skills.intelligence}}</span>
      <span>{{system.skillsModifiers.intelligence}}</span>
    </div>
    <div class="sheet-skills-skill">
      <span>Instinct: {{system.skills.instinct}}</span>
      <span>{{system.skillsModifiers.instinct}}</span>
    </div>
    <div class="sheet-skills-skill">
      <span>Charisme: {{system.skills.charisma}}</span>
      <span>{{system.skillsModifiers.charisma}}</span>
    </div>
  </section>

  {{! Sheet Tab Navigation }}
  <nav class="sheet-tabs tabs" role="tablist" data-group="primary">
    {{#each tabs as |tab|}}
    <a class="dg-tab {{tab.cssClass}}" role="tab"
      id="{{../tabFieldId}}-tab-{{tab.id}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}"
      aria-controls="{{../tabFieldId}}-panel-{{tab.id}}" aria-selected="{{tab.active}}"
      tabindex="{{#if tab.active}}0{{else}}-1{{/if}}">{{tab.label}}</a>
  {{/each}}
  </nav>

  {{! Sheet Body }}
  <section class="sheet-body">

    {{! Biography Tab }}
    <div class="tab biography {{tabs.resume.cssClass}}" data-group="primary" data-tab="resume" role="tabpanel">
      Description here
    </div>

    {{! Owned Items Tab }}
    <div class="tab items {{tabs.actions.cssClass}}" data-group="primary" data-tab="actions" role="tabpanel">
      actions items here
    </div>

    {{! Owned Items Tab }}
    <div class="tab items {{tabs.abilities.cssClass}}" data-group="primary" data-tab="abilities" role="tabpanel">
      abilities items here
    </div>

    {{! Owned Items Tab }}
    <div class="tab items {{tabs.inventory.cssClass}}" data-group="primary" data-tab="inventory" role="tabpanel">
      inventory items here
    </div>
    {{! Owned Items Tab }}
    <div class="tab items {{tabs.notes.cssClass}}" data-group="primary" data-tab="notes" role="tabpanel">
      notes items here
    </div>
  </section>
</section>