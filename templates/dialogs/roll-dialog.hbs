<div class="septaris roll-dialog">
      
  <fieldset class="form-group radio-group">
    <legend>{{localize "SEPTARIS.Sheet.Skills"}}</legend>
    <div class="roll-skills">
      {{#each rollConfig.skills as |modifier skill|}}
        <label class="radio">
          <input
            type="radio"
            name="skill"
            value="{{skill}}"
          >
          <span>{{localize (concat "SEPTARIS.SKILL." (toUpperCase skill))}} ({{numberFormat modifier sign=true}})</span>
        </label>
      {{/each}}
    </div>
  </fieldset>

  <fieldset class="form-group radio-group">
    <legend>{{localize "SEPTARIS.Sheet.Capacities"}}</legend>
    <div class="roll-capacities">
      {{#each rollConfig.capacities as |proficiency name|}}
        <label class="radio" title={{proficiencyName proficiency }}>
          <input
            type="radio"
            name="capacity"
            value="{{name}}"
          >
          <span>{{capacityProficiency proficiency}} {{capacityName name}}</span>
        </label>
      {{/each}}
    </div>
  </fieldset>
  
  <fieldset class="form-group radio-group">
    <legend>{{localize "SEPTARIS.Interface.Bonus"}}</legend>

    <div class="roll-narration">

        <span>{{localize "SEPTARIS.Interface.NarrationBonus"}}</span>
        <label class="radio">
          <input
            type="radio"
            name="narration"
            value="0"
            checked
          >
          <span>0</span>
        </label>
        <label class="radio">
          <input
            type="radio"
            name="narration"
            value="1"
          >
          <span>+1</span>
        </label>
        <label class="radio">
          <input
            type="radio"
            name="narration"
            value="2"
          >
          <span>+2</span>
        </label>
    </div>
    <div class="roll-bonus">
      <label class="input">
        <span>{{localize "SEPTARIS.Interface.Bonus"}} : </span>
        <input type="number" name="bonus" value="{{rollConfig.bonus}}" />
      </label>
    </div>
  </fieldset>

  <fieldset class="form-group radio-group">
    <legend>{{localize "SEPTARIS.Interface.RollMode"}}</legend>

    <div class="roll-mode">

      {{#each modes}}
        <label class="radio">
          <input
            type="radio"
            name="mode"
            value="{{this.value}}"
            {{#if (eq this.value "normal")}}checked{{/if}}
          >
          <span>{{this.label}}</span>
        </label>
      {{/each}}
    </div>
  </fieldset>

  <fieldset class="form-group radio-group">
    <legend>{{localize "SEPTARIS.Interface.RollVisibility"}}</legend>

    <div class="roll-visibility">
      {{#each messageModes}}
        <label class="radio">
          <input
            type="radio"
            name="messageMode"
            value="{{this.value}}"
            {{#if (eq ../rollConfig.messageMode this.value)}}checked{{/if}}
          >
          <span><i class="{{this.icon}}" aria-hidden="true"></i>{{this.label}}</span>
        </label>
      {{/each}}
    </div>
  </fieldset>

  <fieldset class="form-group radio-group">
    <legend>{{localize "SEPTARIS.Interface.Difficulty"}}</legend>

    <div class="roll-visibility">
      <input
        type="number"
        name="difficulty"
        value="10"
      >
    </div>
  </fieldset>

  <footer class="actions row">
    <button type="submit">{{localize "SEPTARIS.Interface.Roll.Launch"}}</button>
    <button type="button" data-action="cancel-roll">{{localize "SEPTARIS.Interface.Roll.Cancel"}}</button>
  </footer>
</div>