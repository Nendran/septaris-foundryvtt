{
  "name": "septaris",
  "private": true,
  "version": "0.7.0",
  "description": "Système FoundryVTT pour le JDR Septaris.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "npm run typecheck && biome ci .",
    "test": "npm run build && node --test",
    "test:watch": "npm run build && node --test --watch"
  },
  "keywords": [
    "Septaris",
    "FoundryVTT"
  ],
  "author": "Vilsafur",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@dfreds/foundry-types": "^14.369.1",
    "@types/showdown": "^2.0.6",
    "typescript": "^7.0.2"
  }
}
